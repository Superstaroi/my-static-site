{
  "name": "react-example",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-utf8-console.mjs && vite --port=9527 --strictPort --host=0.0.0.0",
    "dev:server": "npm --prefix server run dev",
    "build:server": "npm --prefix server run build",
    "build": "node scripts/ensure-utf8-console.mjs && vite build",
    "preview": "node scripts/ensure-utf8-console.mjs && vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "clean:all": "npm run clean && npm --prefix server run clean",
    "preflight": "node scripts/preflight.mjs",
    "verify": "npm run preflight",
    "package:source": "npm run preflight && node scripts/package-source.mjs",
    "release:zip": "npm run package:source",
    "lint": "node scripts/ensure-utf8-console.mjs && tsc --noEmit",
    "db:migrate": "npm --prefix server run db:migrate",
    "seed:admin": "npm --prefix server run seed:admin",
    "reset:admin": "npm --prefix server run reset:admin"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.2",
    "uuid": "^13.0.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
