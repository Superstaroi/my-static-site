# Backend env only. Do not put real model keys in frontend .env files.
# Copy this file to server/.env before running backend scripts.

PORT=9528
CLIENT_ORIGIN=http://localhost:9527,http://127.0.0.1:9527
DB_HOST=localhost
DB_PORT=3306
DB_NAME=MyTestDatabase
DB_USER=root
DB_PASSWORD=123456
JWT_SECRET=please_change_me
TZ=Asia/Shanghai
REQUEST_BODY_LIMIT=50mb
COOKIE_SECURE=false
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3-flash-preview
GEMINI_STRUCTURED_MODEL=gemini-3.1-pro-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_IMAGE_PRO_MODEL=gemini-3-pro-image-preview
GEMINI_VERIFY_MODEL=gemini-3.1-pro-preview
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_ANALYSIS_MODEL=gpt-5.4
OPENAI_IDENTITY_MODEL=gpt-5.4
OPENAI_IDENTITY_FALLBACK_MODEL=gpt-5.4-mini
